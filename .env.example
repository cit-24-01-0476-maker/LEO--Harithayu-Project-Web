PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
# Use a long, unique password. The admin login is disabled without it.
ADMIN_PASSWORD=
# Fill all bank fields and set true only after the club approves collecting funds.
DONATIONS_ENABLED=false
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
CONTACT_EMAIL=
CONTACT_PHONE=
# Optional: real project footage as a direct MP4 URL, not a YouTube watch link.
PROJECT_VIDEO_URL=
# Vercel uses a remote persistent database; local development defaults to SQLite.
# Never commit a real auth token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Marketplace Neon connection (takes priority over Turso).
DATABASE_URL=

# Optional private Google Form + Sheet + Drive mirror (server only).
GOOGLE_BRIDGE_URL=
GOOGLE_BRIDGE_SECRET=

# Show proof submissions automatically, without claiming bank verification.
AUTO_ACCEPT_SUBMISSIONS=false
# Optional one-time recoverable archive cutoff (UTC ISO timestamp).
ARCHIVE_DONATIONS_BEFORE=
